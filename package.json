{
  "name": "gallerify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:setup": "scripts/worktree-dev/bootstrap-worktree.sh",
    "dev:up": "scripts/worktree-dev/gallerify-worktree-dev up",
    "dev:status": "scripts/worktree-dev/gallerify-worktree-dev status",
    "dev:down": "scripts/worktree-dev/gallerify-worktree-dev down",
    "dev:logs": "scripts/worktree-dev/gallerify-worktree-dev logs",
    "test:worktree": "node --test scripts/worktree-dev/worktree.test.mjs",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx,mjs --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixi/react": "^7.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "^2.0.0",
    "@react-three/drei": "^9.88.13",
    "@react-three/fiber": "^8.15.10",
    "pixi.js": "^7.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.158.0",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/three": "^0.158.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.0.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
