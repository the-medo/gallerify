# Local email/password accounts need no external credentials.
# Worktree setup copies this template to .env.local only when it does not exist.
# Add optional development settings there; never commit local env files.
# Vite exposes any VITE_* value to the browser. Do not put secrets in VITE_*.
# The launcher owns .env.worktree (port and worktree identity); do not copy it.

# Optional public asset base URL. Leave blank to use the gallerify R2 development
# endpoint. For production, set a custom domain connected to the same bucket.
# Object paths such as /textures/wall/chalk-plaster.webp are appended to this URL.
VITE_ASSET_BASE_URL=

# Server only. Development generates a per-worktree secret when blank and uses
# the exact local server origin. With a remote browser/tunnel, set BETTER_AUTH_URL
# to the origin in the browser's address bar and register its Google callback.
# In production all three values are required:
# a random secret (openssl rand -base64 48), HTTPS origin, and persistent DB path.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DATABASE_PATH=

# Optional locally; both are required to enable Continue with Google.
# Create a Google Auth Platform Web application client. Register the exact URL
# used in the browser plus /api/auth/callback/google as its redirect URI.
# For Tailscale or a tunnel, this is BETTER_AUTH_URL, not dev:status's listener.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
