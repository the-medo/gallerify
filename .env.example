# Gallerify needs no credentials. Textures load from the public R2 bucket.
# Worktree setup copies this template to .env.local only when it does not exist.
# Add optional development settings there; never commit local env files.
# Vite exposes any VITE_* value to the browser. Do not put secrets in VITE_*.
# The launcher owns .env.worktree (port and worktree identity); do not copy it.

# Optional public asset base URL. Leave blank to use the gallerify R2 development
# endpoint. For production, set a custom domain connected to the same bucket.
# Object paths such as /textures/wall/chalk-plaster.webp are appended to this URL.
VITE_ASSET_BASE_URL=
